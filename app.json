    "scheme": "vimo",
    "icon": "./assets/branding/vimo-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/vimo-icon.png",
        "backgroundColor": "#006A70"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7af23123-e0c7-4576-9fb2-b50aeb918a1c"
      }
    },
    "owner": "ndhphuc"
  }
}
